import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import nltk
from nltk.sentiment.vader import SentimentIntensityAnalyzer

# 1. Download VADER lexicon for Sentiment Analysis
nltk.download('vader_lexicon', quiet=True)
sia = SentimentIntensityAnalyzer()

# ==========================================
# Step 1: Download Asset Price History (AAPL)
# ==========================================
print("Downloading price history for AAPL...")
ticker = "AAPL"
# Download exactly one year of data
start_date = "2023-01-01"
end_date = "2024-01-01"
data = yf.download(ticker, start=start_date, end=end_date)

# Keep only the Close price and flatten if yfinance returns multi-index
if isinstance(data.columns, pd.MultiIndex):
    data = data['Close'].to_frame()
    data.columns = ['Close']
else:
    data = data[['Close']]

# ==========================================
# Step 2: Download/Get Historical News Feed
# ==========================================
print("Loading official news feed dataset...")

# In a real-world scenario with a paid API or downloaded dataset, you would do this:
# news_df = pd.read_csv("historical_apple_news.csv") # Columns: ['Date', 'Headline']

# Because free historical news APIs do not exist for a full year back, 
# we generate a realistic synthetic dataset of headlines for the trading days.
np.random.seed(42)
headlines_pool = [
    "Apple announces record breaking iPhone sales.", # Very Positive
    "Apple faces severe supply chain disruptions in China.", # Very Negative
    "Analysts upgrade Apple stock to strong buy.", # Positive
    "Apple sued for antitrust violations in Europe.", # Negative
    "Apple releases new software update for iOS.", # Neutral
    "Earnings report shows slower growth than expected for Apple.", # Negative
    "Apple acquires new AI startup to boost Siri.", # Positive
    "Tim Cook discusses future plans at tech conference." # Neutral
]

# Generate random news for our trading dates
news_data = []
for date in data.index:
    # 0 to 3 news headlines per day
    num_headlines = np.random.randint(0, 4) 
    for _ in range(num_headlines):
        headline = np.random.choice(headlines_pool)
        news_data.append({'Date': date, 'Headline': headline})

news_df = pd.DataFrame(news_data)

# ==========================================
# Step 3: Analyze Sentiment
# ==========================================
print("Analyzing news sentiment...")
def get_sentiment(text):
    # VADER returns a compound score between -1 (extreme negative) and +1 (extreme positive)
    return sia.polarity_scores(text)['compound']

news_df['Sentiment'] = news_df['Headline'].apply(get_sentiment)

# Group multiple news items per day by taking the average sentiment
daily_sentiment = news_df.groupby('Date')['Sentiment'].mean().to_frame()

# Merge sentiment with price data
df = data.merge(daily_sentiment, how='left', left_index=True, right_index=True)
# Fill days with no news with 0 (neutral sentiment)
df['Sentiment'] = df['Sentiment'].fillna(0) 

# ==========================================
# Step 4: The Trading Strategy Logic
# ==========================================
print("Running Backtest...")

INITIAL_CAPITAL = 10000.0
capital = INITIAL_CAPITAL
shares = 0

# Strategy Thresholds
BUY_THRESHOLD = 0.20   # Buy if sentiment is positive enough
SELL_THRESHOLD = -0.20 # Sell if sentiment is negative enough

portfolio_values = []

for date, row in df.iterrows():
    sentiment = row['Sentiment']
    price = row['Close']
    
    # 1. Trading Logic (Executes at the Close price of the day)
    if sentiment >= BUY_THRESHOLD and capital > 0:
        # BUY signal: Invest all available capital
        shares = capital / price
        capital = 0.0
        # print(f"{date.date()} - BUY at ${price:.2f}")
        
    elif sentiment <= SELL_THRESHOLD and shares > 0:
        # SELL signal: Liquidate all shares
        capital = shares * price
        shares = 0.0
        # print(f"{date.date()} - SELL at ${price:.2f}")
        
    # 2. Record daily portfolio value
    current_value = capital + (shares * price)
    portfolio_values.append(current_value)

df['Portfolio_Value'] = portfolio_values

# ==========================================
# Step 5: Calculate Annual Profit & Compare
# ==========================================

# Calculate System Profit
final_portfolio_value = df['Portfolio_Value'].iloc[-1]
system_profit_pct = ((final_portfolio_value - INITIAL_CAPITAL) / INITIAL_CAPITAL) * 100

# Calculate Buy & Hold Profit
first_price = df['Close'].iloc[0]
last_price = df['Close'].iloc[-1]
buy_and_hold_pct = ((last_price - first_price) / first_price) * 100

print("-" * 30)
print(f"System Final Value: ${final_portfolio_value:.2f}")
print(f"System Annual Profit: {system_profit_pct:.2f}%")
print(f"Buy & Hold Annual Profit: {buy_and_hold_pct:.2f}%")
print("-" * 30)

# ==========================================
# Step 6: Visualization
# ==========================================
plt.figure(figsize=(12, 6))

# Plot System Portfolio Value
plt.plot(df.index, df['Portfolio_Value'], label='News Sentiment Strategy', color='blue')

# Plot Buy & Hold Value (starting with the same initial capital)
df['Buy_Hold_Value'] = (INITIAL_CAPITAL / first_price) * df['Close']
plt.plot(df.index, df['Buy_Hold_Value'], label='Buy & Hold Strategy', color='orange')

plt.title('News Sentiment Trading System vs Buy & Hold (AAPL)')
plt.xlabel('Date')
plt.ylabel('Portfolio Value ($)')
plt.legend()
plt.grid(True)
plt.show()
